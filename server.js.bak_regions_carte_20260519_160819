// Accepte aussi bien "01" que "1" pour les départements à 1 chiffre.
function _acceptedNumeros(num) {
    const set = new Set([num.toLowerCase()]);
    if (/^0[1-9]$/.test(num)) set.add(num[1]); // "01" → "1"
    return [...set];
}

// Génère plusieurs formes acceptées pour un nom de lieu (département, ville,
// pays, capitale…) :
//   - forme canonique (sans accent, minuscule)
//   - tirets remplacés par espaces
//   - apostrophes remplacées par espaces
//   - tirets ET apostrophes remplacés par espaces
//   - variante avec abréviation Saint→St, Sainte→Ste (et toutes les combi-
//     naisons hyphens/apostrophes ci-dessus appliquées à cette variante)
//   - tout `extras` supplémentaire fourni explicitement par l'appelant (ex.
//     "Évry" comme alias de "Évry-Courcouronnes", "Bujumbura" comme ancien
//     nom de Gitega, "Le Cap" comme capitale alternative de l'Afrique du Sud)
// Toutes les variantes sont normalisées (accents retirés) pour matcher la
// fonction `normalize()` côté serveur.
function _acceptedNoms(name, extras = []) {
    const norm = s => s.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
    const set = new Set();

    // Pour une chaîne donnée, on ajoute toutes ses déclinaisons hyphens/apos.
    const addAllForms = (s) => {
        set.add(s);
        set.add(s.replace(/-/g, ' ').replace(/\s+/g, ' ').trim());
        set.add(s.replace(/'/g, ' ').replace(/\s+/g, ' ').trim());
        set.add(s.replace(/[-']/g, ' ').replace(/\s+/g, ' ').trim());
    };

    const base = norm(name);
    addAllForms(base);

    // Variante avec abréviation Saint→St / Sainte→Ste (utile pour Saint-Étienne,
    // Saint-Brieuc, Saint-Lô, Sainte-Lucie, etc.).
    const withStAbbr = base
        .replace(/\bsainte-/g, 'ste-')
        .replace(/\bsainte /g, 'ste ')
        .replace(/\bsaint-/g, 'st-')
        .replace(/\bsaint /g, 'st ');
    if (withStAbbr !== base) addAllForms(withStAbbr);

    // Extras manuels fournis par l'appelant.
    for (const e of extras) addAllForms(norm(e));

    return [...set];
}

