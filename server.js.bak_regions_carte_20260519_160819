// Fonction pour générer un code aléatoire à 4 lettres
function generateRoomCode() {
    const chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    let code = '';
    for (let i = 0; i < 4; i++) {
        code += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return code;
}

function shuffle(array) {
    for (let i = array.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [array[i], array[j]] = [array[j], array[i]];
    }
    return array;
}

/**
 * Construit une liste ordonnée de questions avec une montée *progressive*
 * en difficulté (et non plus par paliers stricts).
 *
 *  - Convention inchangée : chaque question peut porter un champ `difficulty`
 *    valant 1 (facile), 2 (moyen) ou 3 (difficile). Les questions sans champ
 *    sont traitées comme 2 (moyen).
 *  - Les WARMUP premières positions sont garanties en difficulté 1, peu
 *    importe le thème. Si le palier 1 est plus petit que WARMUP, on retombe
 *    sur le palier non vide le plus proche.
 *  - Au-delà de WARMUP, chaque position est tirée au sort dans un mélange
 *    pondéré des trois paliers : le poids de la difficulté 1 décroît, celui
 *    de la difficulté 3 croît (avec un léger délai). La difficulté 2 occupe
 *    le reste.
 *  - Conséquence : on n'épuise plus tout le palier 1 avant de voir un palier
 *    2 ou 3. Plus le duel s'éternise, plus les questions difficiles sont
 *    probables — quitte à laisser des questions faciles non utilisées.
 *
 *  Les constantes ci-dessous contrôlent la pente exacte de la progression :
 *  baisser D1_DECAY ralentit la montée en difficulté, monter D3_GROWTH la
 *  rend plus brutale, etc.
 */
function shuffleByDifficulty(array) {
    const tiers = { 1: [], 2: [], 3: [] };
    for (const q of array) {
        const d = (q.difficulty === 1 || q.difficulty === 3) ? q.difficulty : 2;
        tiers[d].push(q);
    }
    // Mélange interne à chaque palier pour que l'ordre exact varie d'une partie à l'autre.
    shuffle(tiers[1]);
    shuffle(tiers[2]);
    shuffle(tiers[3]);

    // --- Paramètres de la progression de difficulté (ajustables) ---
    const WARMUP = 4;        // Nb de questions garanties en difficulté 1 au début
    const D1_DECAY = 0.10;   // Décroissance du poids de D1 par position après le warmup
    const D1_FLOOR = 0.10;   // Plancher du poids de D1 (D1 ne disparaît jamais totalement)
    const D3_DELAY = 2;      // Positions après le warmup avant que D3 commence à apparaître
    const D3_GROWTH = 0.07;  // Croissance du poids de D3 par position
    const D3_CEIL = 0.50;    // Plafond du poids de D3

    // Choisit un palier pour la position donnée (1-indexée).
    // Si le palier "tiré" est vide, on retombe sur le palier non vide le plus proche.
    function pickTier(position) {
        let w1, w2, w3;
        if (position <= WARMUP) {
            // Phase de warmup : on force la difficulté 1.
            w1 = 1; w2 = 0; w3 = 0;
        } else {
            const t = position - WARMUP; // 1, 2, 3, …
            w1 = Math.max(D1_FLOOR, 1 - D1_DECAY * t);
            w3 = Math.max(0, Math.min(D3_CEIL, D3_GROWTH * (t - D3_DELAY)));
            w2 = Math.max(0, 1 - w1 - w3);
        }

        // Tirage pondéré du palier souhaité.
        const total = w1 + w2 + w3;
        let desired = 2; // garde-fou théorique
        if (total > 0) {
            let r = Math.random() * total;
            if ((r -= w1) < 0) desired = 1;
            else if ((r -= w2) < 0) desired = 2;
            else desired = 3;
        }

        // Si le palier souhaité est vide, on prend le voisin non vide le plus proche.
        if (tiers[desired].length > 0) return desired;
        const fallbackOrder = (desired === 1) ? [2, 3]
                            : (desired === 3) ? [2, 1]
                            : [1, 3];
        for (const d of fallbackOrder) {
            if (tiers[d].length > 0) return d;
        }
        return null; // plus aucune question disponible
    }

    const ordered = [];
    let position = 1;
    while (tiers[1].length + tiers[2].length + tiers[3].length > 0) {
        const tier = pickTier(position);
        if (tier === null) break;
        ordered.push(tiers[tier].shift());
        position++;
    }
    return ordered;
}

// Remplace toutes les occurrences d'un ancien socket.id par un nouveau dans
// l'état persistant du match (settings). Utilisé quand un joueur revient dans
// un salon resté vacant après son départ : son nouvel ID doit hériter de ses
// manches gagnées et de ses réponses, sinon le score et l'écran "Réponses"
// l'attribuent à "l'adversaire".
function remapPlayerId(room, oldId, newId) {
    if (!room || !room.settings || oldId === newId) return;
    const s = room.settings;
    if (Array.isArray(s.matchHistory)) {
        s.matchHistory = s.matchHistory.map(id => id === oldId ? newId : id);
    }
    if (Array.isArray(s.matchAnswers)) {
        s.matchAnswers.forEach(a => {
            if (a.playerId === oldId) a.playerId = newId;
        });
    }
    if (s.score && Object.prototype.hasOwnProperty.call(s.score, oldId)) {
        s.score[newId] = s.score[oldId];
        delete s.score[oldId];
    }
    if (s.nextRoundStarterId === oldId) {
        s.nextRoundStarterId = newId;
    }
}

// Construit l'instantané du match en cours à renvoyer au client qui (re)joint
// le salon. Permet de restaurer l'affichage Manche X/X, le score et l'écran
// "Réponses" même après un aller-retour par l'écran d'accueil.
function buildLobbyMatchState(room) {
    if (!room || !room.settings) return null;
    const s = room.settings;
    const hasMatch = Array.isArray(s.matchHistory) && s.rounds > 1;
    if (!hasMatch) return null;
    return {
        rounds: s.rounds,
        currentRound: s.currentRound || (s.matchHistory.length + 1),
        matchHistory: s.matchHistory.slice(),
        matchAnswers: Array.isArray(s.matchAnswers) ? s.matchAnswers.slice() : [],
        score: Object.assign({}, s.score || {}),
        mode: s.mode || null,
        theme: s.theme || null,
        timer: s.timer || null
    };
}

// Nettoie tous les timers/timeouts associés à un gameState et le neutralise.
function cleanupGameTimers(room) {
    if (!room || !room.gameState) return;
    if (room.gameState.timerInterval) clearInterval(room.gameState.timerInterval);
    if (room.gameState.transitionTimeout) clearTimeout(room.gameState.transitionTimeout);
    if (room.gameState.startGameTimeout) clearTimeout(room.gameState.startGameTimeout);
    room.gameState = null;
}

// Délai (ms) pendant lequel un salon vidé reste réservé, le temps que l'hôte
// puisse revenir via l'écran d'accueil sans perdre l'état du match.
const ROOM_VACANT_TTL_MS = 10 * 60 * 1000;

function scheduleRoomCleanup(code) {
    const room = rooms[code];
    if (!room) return;
    if (room.cleanupTimeout) clearTimeout(room.cleanupTimeout);
    room.cleanupTimeout = setTimeout(() => {
        if (rooms[code] && rooms[code].players.length === 0) {
            delete rooms[code];
            console.log(`Room ${code} supprimée après inactivité (${ROOM_VACANT_TTL_MS / 1000}s).`);
        }
    }, ROOM_VACANT_TTL_MS);
}

function cancelRoomCleanup(room) {
    if (room && room.cleanupTimeout) {
        clearTimeout(room.cleanupTimeout);
        room.cleanupTimeout = null;
    }
}

function startGame(code) {
    const room = rooms[code];
    if (!room || !room.gameState) return;

    io.to(code).emit('init-game', {
        question: room.gameState.questions[0],
        activePlayerId: room.gameState.activePlayerId,
        times: room.gameState.times,
        theme: room.settings.theme,
        mode: room.settings.mode || 'images',
        avatars: room.avatars || {},
        rounds: room.settings.rounds || 1,
        winsNeeded: room.settings.winsNeeded || 1,
        score: room.settings.score || {},
        matchHistory: room.settings.matchHistory || [],
        currentRound: room.settings.currentRound || 1,
        matchAnswers: room.settings.matchAnswers || []
    });

    // Le client affiche un écran de transition (compte à rebours 3-2-1) pendant
    // 2 secondes avant que le duel ne devienne réellement visible. On retarde
    // d'autant le démarrage du chrono côté serveur, sinon les joueurs perdraient
    // ces 2 secondes sans pouvoir jouer.
    room.gameState.startGameTimeout = setTimeout(() => {
        const r = rooms[code];
        if (!r || !r.gameState) return; // partie annulée pendant la transition
        startRoundTimer(code);
    }, 2000);
}

function getActiveRemainingTime(state, now = Date.now()) {
    if (!state || !state.activePlayerId || !state.times) return 0;
    const activeId = state.activePlayerId;
    const startAt = typeof state.activeTurnStartedAt === 'number'
        ? state.activeTurnStartedAt
        : now;
    const startValue = typeof state.activeTurnStartValue === 'number'
        ? state.activeTurnStartValue
        : Number(state.times[activeId] || 0);
    const elapsed = (now - startAt) / 1000;
    return Math.max(0, startValue - elapsed);
}

function freezeActiveTimer(state, now = Date.now()) {
    if (!state || !state.activePlayerId || !state.times) return;
    const activeId = state.activePlayerId;
    state.times[activeId] = getActiveRemainingTime(state, now);
    state.activeTurnStartedAt = null;
    state.activeTurnStartValue = null;
}

// Lance / relance le décompte du joueur actif pour la manche courante.
// Le serveur conserve maintenant les décimales réelles du chrono : quand un
// joueur répond entre deux ticks serveur, on fige son temps exact au centième
// côté client au lieu de revenir à la seconde entière supérieure.
function startRoundTimer(code) {
    const room = rooms[code];
    if (!room || !room.gameState) return;

    const state = room.gameState;
    if (state.timerInterval) clearInterval(state.timerInterval);

    const activeId = state.activePlayerId;
    if (!activeId) return;

    state.activeTurnStartedAt = Date.now();
    state.activeTurnStartValue = Number(state.times[activeId] || 0);

    state.timerInterval = setInterval(() => {
        const currentRoom = rooms[code];
        if (!currentRoom || !currentRoom.gameState) return;

        const currentState = currentRoom.gameState;
        const currentActiveId = currentState.activePlayerId;
        if (!currentActiveId) return;

        const remaining = getActiveRemainingTime(currentState);
        currentState.times[currentActiveId] = remaining;

        if (remaining <= 0) {
            currentState.times[currentActiveId] = 0;
            clearInterval(currentState.timerInterval);
            currentState.timerInterval = null;
            currentState.activeTurnStartedAt = null;
            currentState.activeTurnStartValue = null;
            handleRoundEnd(code, currentActiveId);
        } else {
            io.to(code).emit('timer-update', currentState.times);
        }
    }, 1000);
}

// Appelé quand un joueur a épuisé son temps sur la manche en cours.
// loserId = celui dont le timer est tombé à 0.
function handleRoundEnd(code, loserId) {
    const room = rooms[code];
    if (!room || !room.gameState) return;
    const winnerId = room.players.find(id => id !== loserId);
    const winsNeeded = room.settings.winsNeeded || 1;

    // Enregistrer la question qui était à l'écran quand le temps a expiré
    // (avant d'incrémenter currentRound pour avoir le bon numéro de manche)
    const timedOutQuestion = room.gameState.questions[room.gameState.currentQuestionIndex];
    if (timedOutQuestion) {
        room.settings.matchAnswers = room.settings.matchAnswers || [];
        room.settings.matchAnswers.push({
            question: timedOutQuestion,
            mode: room.settings.mode || 'images',
            outcome: 'timeout',
            playerId: loserId,
            round: room.settings.currentRound || 1
        });
    }

    // Mettre à jour l'historique et le score dans room.settings (persiste entre manches)
    room.settings.matchHistory = room.settings.matchHistory || [];
    room.settings.matchHistory.push(winnerId);
    room.settings.score = room.settings.score || {};
    room.settings.score[winnerId] = (room.settings.score[winnerId] || 0) + 1;
    room.settings.currentRound = (room.settings.currentRound || 1) + 1;
    room.settings.nextRoundStarterId = loserId;

    const score = room.settings.score;
    const matchHistory = room.settings.matchHistory;
    const nextRound = room.settings.currentRound;
    const matchAnswers = room.settings.matchAnswers || [];

    // Match terminé ?
    if (score[winnerId] >= winsNeeded) {
        // Nettoyer l'état du match pour la prochaine partie.
        // matchAnswers reste disponible (envoyé dans game-over) jusqu'au prochain start-game.
        room.settings.matchHistory = undefined;
        room.settings.score = undefined;
        room.settings.currentRound = 1;
        room.settings.nextRoundStarterId = null;

        io.to(code).emit('game-over', { winnerId, score, matchHistory, matchAnswers });
        return;
    }

    // Fin de manche sans fin de match :
    // 1. Informer les clients du résultat
    io.to(code).emit('round-end', {
        roundWinnerId: winnerId,
        roundLoserId: loserId,
        score,
        matchHistory,
        nextRound,
        matchAnswers
    });

    const isMatchmaking = code.startsWith('MATCH-');

    if (isMatchmaking) {
        // Matchmaking : relance automatique après 3s
        room.gameState.transitionTimeout = setTimeout(() => {
            const r = rooms[code];
            if (!r || !r.gameState) return;
            r.gameState.times = {
                [r.players[0]]: r.settings.timer,
                [r.players[1]]: r.settings.timer
            };
            r.gameState.activePlayerId = loserId;
            if (r.gameState.currentQuestionIndex >= r.gameState.questions.length) {
                r.gameState.questions = shuffleByDifficulty([...r.gameState.questions]);
                r.gameState.currentQuestionIndex = 0;
            }
            const nextQuestion = r.gameState.questions[r.gameState.currentQuestionIndex];
            io.to(code).emit('round-start', {
                question: nextQuestion,
                activePlayerId: r.gameState.activePlayerId,
                times: r.gameState.times,
                currentRound: r.settings.currentRound,
                score: r.settings.score,
                matchHistory: r.settings.matchHistory,
                matchAnswers: r.settings.matchAnswers || []
            });
            startRoundTimer(code);
        }, 3000);
    } else {
        // Partie privée : retour au salon après 2s
        room.gameState.transitionTimeout = setTimeout(() => {
            const r = rooms[code];
            if (!r) return;
            if (r.gameState && r.gameState.timerInterval) clearInterval(r.gameState.timerInterval);
            r.gameState = null;
            io.to(code).emit('return-to-lobby', {
                matchHistory: r.settings.matchHistory,
                score: r.settings.score,
                nextRound: r.settings.currentRound,
                rounds: r.settings.rounds,
                winsNeeded: r.settings.winsNeeded,
                matchAnswers: r.settings.matchAnswers || []
            });
        }, 2000);
    }
}

function normalize(str) {
    return str.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase().trim();
}

