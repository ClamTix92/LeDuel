        state.currentQuestionIndex++;

        // Même chose que pour une bonne réponse : stopper le tick avant
        // d'émettre next-round pour éviter un timer-update parasite.
        if (state.timerInterval) {
            clearInterval(state.timerInterval);
            state.timerInterval = null;
        }

        io.to(code).emit('next-round', {
            nextQuestion: state.questions[state.currentQuestionIndex],
            activePlayerId: state.activePlayerId,
            times: state.times,
            matchAnswers: room.settings.matchAnswers || []
        });

        // Relancer le timer sur le joueur actif (inchangé lors d'un pass).
        startRoundTimer(code);
    });

    // --- 3.3 DÉMARRAGE APRÈS MATCHMAKING ---
    socket.on('matchmaking-ready', (data) => {
        const room = rooms[data.code];

        // Sécurité : Seul le joueur qui doit commencer peut déclencher le départ 
        // pour éviter que l'événement soit reçu deux fois.
        if (room && room.gameState.activePlayerId === socket.id) {
            console.log(`Le match ${data.code} commence !`);
            startGame(data.code);
        }
    });

    // --- 3.4 INTERROMPRE UNE PARTIE EN COURS (bouton retour pendant le duel) ---
    // Le joueur reste dans la room (donc dans le lobby), mais la partie est annulée :
    // on tue le timer côté serveur et on prévient l'autre joueur pour qu'il revienne
    // aussi au lobby (sinon il se retrouverait seul avec un chrono qui descend).
    socket.on('abort-game', () => {
        const code = getPlayerRoom(socket.id);
        if (!code) return;
        const room = rooms[code];
        if (!room || !room.gameState) return; // déjà terminée / annulée

        if (room.gameState.timerInterval) {
            clearInterval(room.gameState.timerInterval);
        }
        if (room.gameState.transitionTimeout) {
            clearTimeout(room.gameState.transitionTimeout);
        }
        // Pendant l'écran de transition (3-2-1), le chrono n'a pas encore démarré :
        // il faut annuler le setTimeout sinon il déclenchera startRoundTimer dans
        // une partie déjà annulée.
        if (room.gameState.startGameTimeout) {
            clearTimeout(room.gameState.startGameTimeout);
        }
        room.gameState = null;

        // Prévenir l'autre joueur de la room (pas soi-même)
        socket.to(code).emit('opponent-aborted');
        console.log(`Partie de la room ${code} annulée par ${socket.id}.`);
    });

    // --- 4. QUITTER UNE ROOM VOLONTAIREMENT (bouton retour du lobby) ---
    socket.on('leave-room', (data) => {
        const code = data && data.code ? data.code.toUpperCase() : null;
        if (!code || !rooms[code]) return;

        const room = rooms[code];
        const index = room.players.indexOf(socket.id);
        if (index === -1) return;

        const wasHost = (room.host === socket.id);

        // Retirer le joueur de la room et du canal Socket.IO
        room.players.splice(index, 1);
        if (room.avatars) delete room.avatars[socket.id];
        socket.leave(code);

        if (room.players.length === 0) {
            // Plus personne, mais on ne supprime pas la room tout de suite :
            // l'hôte peut revenir en saisissant son code. On nettoie en revanche
            // la partie en cours (timers, gameState) — l'état du match
            // (matchHistory, score, matchAnswers, rounds) reste intact dans
            // room.settings pour être restauré au retour.
            cleanupGameTimers(room);
            room.host = null;
            // On mémorise l'ID du dernier hôte pour pouvoir réattribuer son
            // score / ses réponses à son nouveau socket.id au retour.
            if (wasHost) {
                room.previousHostId = socket.id;
            }
            scheduleRoomCleanup(code);
            console.log(`Room ${code} maintenue vacante (TTL ${ROOM_VACANT_TTL_MS / 1000}s).`);
        } else {
            // Il reste un joueur : si l'hôte est parti, on transfère le rôle.
            if (wasHost) {
                room.host = room.players[0];
            }
            io.to(code).emit('room-update', {
                playerCount: room.players.length,
                hostId: room.host
            });
            console.log(`Joueur ${socket.id} a quitté la room ${code}. Reste ${room.players.length} joueur(s).`);
        }
    });

    // --- 4bis. QUITTER LA FILE DE MATCHMAKING ---
    socket.on('leave-matchmaking', () => {
        const idx = matchmakingQueue.findIndex(e => e.socket === socket);
        if (idx !== -1) {
            matchmakingQueue.splice(idx, 1);
            console.log(`Joueur ${socket.id} a quitté la file. Reste ${matchmakingQueue.length} joueur(s).`);
        }
    });

    // --- 5. DÉCONNEXION ---
    socket.on('disconnect', () => {
        // Retirer de la file de matchmaking si en attente
        const qIdx = matchmakingQueue.findIndex(e => e.socket === socket);
        if (qIdx !== -1) matchmakingQueue.splice(qIdx, 1);
        // Retirer des rooms si en partie — même logique que leave-room :
        // on conserve un salon vacant pour permettre une reconnexion.
        for (const code in rooms) {
            const room = rooms[code];
            const index = room.players.indexOf(socket.id);
            if (index === -1) continue;

            const wasHost = (room.host === socket.id);
            const isMatchmakingRoom = code.startsWith('MATCH-');

            room.players.splice(index, 1);
            if (room.avatars) delete room.avatars[socket.id];

            if (room.players.length === 0) {
                if (isMatchmakingRoom) {
                    // Les salons MATCH- sont éphémères : on les supprime
                    // immédiatement (pas de reconnexion possible avec un code).
                    cleanupGameTimers(room);
                    delete rooms[code];
                } else {
                    // Salon privé : on garde le salon vacant pour permettre
                    // un retour de l'hôte via l'écran d'accueil.
                    cleanupGameTimers(room);
                    room.host = null;
                    if (wasHost) room.previousHostId = socket.id;
                    scheduleRoomCleanup(code);
                }
            } else {
                if (wasHost) room.host = room.players[0];
                io.to(code).emit('room-update', {
                    playerCount: room.players.length,
                    hostId: room.host
                });
            }
            break;
        }
        console.log(`Joueur déconnecté : ${socket.id}`);
    });
});

// On récupère le port donné par Render, ou 3000 par défaut
const PORT = process.env.PORT || 3000;

server.listen(PORT, '0.0.0.0', () => {
    console.log(`Le serveur tourne sur le port ${PORT}`);
});