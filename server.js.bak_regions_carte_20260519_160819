    // --- LIVE SYNC : l'hôte modifie les paramètres → on prévient les autres joueurs du salon
    socket.on('lobby-settings-update', (data) => {
        if (!data || !data.code) return;
        const room = rooms[data.code];
        if (!room) return;
        // Seul l'hôte peut diffuser des modifications de paramètres
        if (room.host !== socket.id) return;
        // Rebroadcast aux autres joueurs du salon (pas à l'hôte lui-même)
        socket.to(data.code).emit('lobby-settings-update', {
            mode: data.mode,
            theme: data.theme,
            timer: data.timer,
            rounds: data.rounds
        });
