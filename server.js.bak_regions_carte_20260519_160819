//                         surligné, ou le DOM seul pour 971/972/973/974/976
//   - Les fichiers PNG sont générés par generate_departements_carte.py
// =====================================================================
function _slugDepartementImage(name) {
    return String(name)
        .replace(/œ/g, "oe")
        .replace(/Œ/g, "Oe")
        .normalize("NFD")
        .replace(/[\u0300-\u036f]/g, "")
        .toLowerCase()
        .replace(/&/g, " et ")
        .replace(/[^a-z0-9]+/g, "_")
        .replace(/^_+|_+$/g, "")
        .replace(/_+/g, "_");
}

